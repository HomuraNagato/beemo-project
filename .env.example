# Secrets and local-only overrides.
#
# Stable app settings live in config/config.yaml.
# CPU/GPU runtime tuning lives in docker-compose.cpu.yaml and docker-compose.gpu.yaml.

OPENAI_API_KEY=

# Optional host-specific runtime settings.
PULSE_SOCKET_PATH=/run/user/1000/pulse/native
PULSE_SERVER=unix:/tmp/pulse/native
PULSE_SOURCE=default
WAKEWORD_ASR_ALIASES=don't be mad,dont be mad,hey bemo,hey bimo,okay bemo,ok bemo
