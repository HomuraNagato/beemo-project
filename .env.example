# Secrets and local-only host overrides.
#
# Stable app settings live in config/config.yaml.
# CPU/GPU runtime tuning and service environment live in docker-compose*.yaml.
MEMORY_PALACE_USER_KEY=user-a

OPENAI_API_KEY=

# Optional host-specific override if your PulseAudio/PipeWire socket is elsewhere.
PULSE_SOCKET_PATH=/run/user/1000/pulse/native
